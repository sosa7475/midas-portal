    {
      "name": "propose_trade",
      "description": "Risk-check a perp order and get a signed intent to confirm. Returns violations if blocked, else a plan + intent token. Owner approves the stored order in Trading control before execute_trade, unless a valid autonomous mandate authorizes it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "BTC/ETH/SOL"
          },
          "side": {
            "type": "string",
            "enum": [
              "long",
              "short"
            ]
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "stopLoss": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "takeProfit": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "requestKey": {
            "type": "string",
            "description": "Stable retry key"
          },
          "slippagePct": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          },
          "price": {
            "type": "number",
            "description": "optional limit"
          }
        },
        "required": [
          "symbol",
          "side",
          "quantity"
        ]
      }
    },
    {
      "name": "execute_trade",
      "description": "Place the trade from a prior propose_trade, using its intent token. Only call after the user confirms.",
