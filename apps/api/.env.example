# Midas API environment — see src/env.ts for validation rules (fail-fast).
NODE_ENV=development
PORT=3001

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth — MUST be a real random value, min 32 chars (placeholder values are rejected)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Encryption for stored user secrets — 64 hex chars (32 bytes), not all zeros
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# CORS — comma-separated browser origins (the Vercel web app)
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting is Postgres-backed (uses DATABASE_URL) — no Redis required.

# LLM provider
ACTIVE_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Orderly Network (testnet by default)
ORDERLY_BASE_URL=https://testnet-api-evm.orderly.org
ORDERLY_BROKER_ID=midas_portal

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
